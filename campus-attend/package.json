{
  "name": "campus-attend-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"FASTAPI,VITE\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "powershell -ExecutionPolicy Bypass -Command \"Set-Location backend; .\\venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8000\"",
    "dev:frontend": "npm --prefix frontend run dev:frontend",
    "build": "npm --prefix frontend run build",
    "test": "powershell -Command \"Set-Location backend; .\\venv\\Scripts\\pytest.exe -v\""
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
